<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="biotex_contract.Progress">
        <div class="o_biotex_contract_progress mb-3 p-3 border rounded bg-light">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Avance por monto (control oficial)</span>
                        <span><b t-esc="(data.progress || 0) + '%'"/> remisionado · <t t-esc="invoicedPct.toFixed(1) + '%'"/> facturado</span>
                    </div>
                    <div class="progress position-relative" style="height: 26px;">
                        <div class="progress-bar" t-att-class="barClass" t-attf-style="width: {{Math.min(100, data.progress || 0)}}%"/>
                        <div class="position-absolute top-0 bottom-0 border-start border-dark border-2" t-attf-style="left: {{data.alert_pct || 85}}%" title="Umbral de alerta"/>
                    </div>
                    <div class="d-flex justify-content-between small mt-1">
                        <span class="text-muted">0</span>
                        <span class="text-muted">Alerta al <t t-esc="data.alert_pct"/>%</span>
                        <span class="text-muted">Tolerancia +<t t-esc="data.tolerance_pct"/>%</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row text-center">
                        <div class="col-4"><div class="small text-muted">Total</div><div class="fw-bold" t-esc="fmt(data.amount_total)"/></div>
                        <div class="col-4"><div class="small text-muted">Remisionado</div><div class="fw-bold text-primary" t-esc="fmt(data.amount_delivered)"/></div>
                        <div class="col-4"><div class="small text-muted">Saldo</div><div class="fw-bold" t-att-class="(data.amount_remaining || 0) &lt; 0 ? 'text-danger' : 'text-success'" t-esc="fmt(data.amount_remaining)"/></div>
                    </div>
                </div>
            </div>
            <details class="mt-3" t-if="data.lines and data.lines.length">
                <summary class="small text-muted" role="button">Avance por clave (informativo: lo entregado puede diferir de lo licitado)</summary>
                <div class="table-responsive mt-2" style="max-height: 260px; overflow:auto;">
                    <table class="table table-sm table-hover mb-0 bg-white">
                        <thead><tr><th>Clave</th><th>Descripción</th><th class="text-end">Contratado</th><th class="text-end">Entregado</th><th class="text-end">Pendiente</th><th style="width:140px">Avance</th></tr></thead>
                        <tbody>
                            <tr t-foreach="data.lines" t-as="l" t-key="l.id" t-att-class="lineClass(l)">
                                <td class="fw-bold" t-esc="l.code"/>
                                <td class="text-truncate" style="max-width:320px" t-att-title="l.name" t-esc="l.name"/>
                                <td class="text-end" t-esc="l.qty"/>
                                <td class="text-end" t-esc="l.qty_delivered"/>
                                <td class="text-end" t-esc="l.qty_remaining"/>
                                <td><div class="progress" style="height:14px"><div class="progress-bar" t-att-class="l.progress >= 100 ? 'bg-success' : 'bg-info'" t-attf-style="width:{{Math.min(100, l.progress)}}%"><small t-esc="l.progress + '%'"/></div></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </details>
        </div>
    </t>
</templates>
