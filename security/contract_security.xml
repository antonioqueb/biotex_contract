<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_contract_multicompany" model="ir.rule">
        <field name="name">Contrato: multiempresa</field>
        <field name="model_id" ref="model_biotex_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_contract_delegation" model="ir.rule">
        <field name="name">Contrato: delegación ve los suyos</field>
        <field name="model_id" ref="model_biotex_contract"/>
        <field name="domain_force">['|', ('warehouse_ids', '=', False), ('warehouse_ids', 'in', user.biotex_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('biotex_base.group_biotex_delegation'))]"/>
    </record>
    <record id="rule_contract_all" model="ir.rule">
        <field name="name">Contrato: compras/dirección ven todo</field>
        <field name="model_id" ref="model_biotex_contract"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('biotex_base.group_biotex_purchase')), (4, ref('biotex_base.group_biotex_direction')), (4, ref('biotex_base.group_biotex_accounting'))]"/>
    </record>
</odoo>
