<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_form" model="ir.ui.view">
        <field name="name">biotex.contract.form</field>
        <field name="model">biotex.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state not in ('active', 'expired')"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Volver a borrador" invisible="state not in ('cancelled', 'expired')" groups="biotex_base.group_biotex_direction"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Número de contrato / partida"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="contract_type"/>
                            <field name="warehouse_ids" widget="many2many_tags"/>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="delivery_mode"/>
                            <field name="amount_contract"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="pricelist_id"/>
                            <field name="tolerance_pct"/>
                            <field name="alert_pct"/>
                        </group>
                    </group>
                    <field name="progress_data" widget="biotex_contract_progress" nolabel="1" invisible="state == 'draft' and not line_ids"/>
                    <notebook>
                        <page string="Claves del contrato" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'active')">
                                <list editable="bottom" decoration-success="progress >= 100" decoration-warning="progress > 0 and progress &lt; 100">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="product_qty"/>
                                    <field name="price_unit"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="qty_delivered" sum="Entregado"/>
                                    <field name="qty_remaining"/>
                                    <field name="amount_delivered" sum="Remisionado"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total"/>
                                <field name="amount_delivered"/>
                                <field name="amount_invoiced"/>
                                <field name="amount_remaining" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Documentos y notas" name="docs">
                            <field name="document_ids" widget="many2many_binary"/>
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contract_list" model="ir.ui.view">
        <field name="name">biotex.contract.list</field>
        <field name="model">biotex.contract</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="contract_type"/>
                <field name="warehouse_ids" widget="many2many_tags" optional="show"/>
                <field name="date_end"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_delivered" sum="Remisionado"/>
                <field name="amount_remaining" sum="Saldo"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expired'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_contract_kanban" model="ir.ui.view">
        <field name="name">biotex.contract.kanban</field>
        <field name="model">biotex.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="progress"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </div>
                        <div><field name="partner_id"/></div>
                        <div class="text-muted small">Vence <field name="date_end"/></div>
                        <field name="progress" widget="progressbar" options="{'editable': false}"/>
                        <div class="d-flex justify-content-between small mt-1">
                            <span>Saldo <field name="amount_remaining"/></span>
                            <span><field name="currency_id" invisible="1"/><field name="amount_total"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_contract_search" model="ir.ui.view">
        <field name="name">biotex.contract.search</field>
        <field name="model">biotex.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="line_ids" string="Clave" filter_domain="[('line_ids.code', 'ilike', self)]"/>
                <filter name="active" string="Vigentes" domain="[('state', '=', 'active')]"/>
                <filter name="near_limit" string="Cerca del límite" domain="[('state', '=', 'active'), ('progress', '>=', 80)]"/>
                <filter name="expiring" string="Vencen en 30 días" domain="[('state', '=', 'active'), ('date_end', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_partner" string="Institución" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_company" string="Razón social" context="{'group_by': 'company_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_contract_line_list" model="ir.ui.view">
        <field name="name">biotex.contract.line.list</field>
        <field name="model">biotex.contract.line</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="qty_delivered"/>
                <field name="qty_remaining"/>
                <field name="price_unit"/>
                <field name="amount_delivered" sum="Remisionado"/>
                <field name="progress" widget="progressbar"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_biotex_contract" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">biotex.contract</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_biotex_contract_lines" model="ir.actions.act_window">
        <field name="name">Avance por clave</field>
        <field name="res_model">biotex.contract.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('state', '=', 'active')]</field>
        <field name="context">{'group_by': 'contract_id'}</field>
    </record>
</odoo>
